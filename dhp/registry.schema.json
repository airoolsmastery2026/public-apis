{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/airoolsmastery2026/public-apis/blob/master/dhp/registry.schema.json",
  "title": "DHP Verified API Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewedAt", "providers"],
  "properties": {
    "schema": {"const": "dhp-verified-api-registry-v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewedAt": {"type": "string", "format": "date"},
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "category", "capabilities", "tier", "authority",
        "docs", "baseUrl", "auth", "cost", "policy", "health", "productionReady"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "name": {"type": "string", "minLength": 2},
        "category": {"type": "string", "minLength": 2},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"}
        },
        "tier": {"enum": ["A", "B", "C"]},
        "authority": {"const": "external-data-or-execution-only"},
        "docs": {"type": "string", "pattern": "^https://"},
        "baseUrl": {"type": "string", "pattern": "^https://"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["none", "optional", "api-key", "bearer", "account-binding"]},
            "secretEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
            "notes": {"type": "string"}
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "denyMeteredOverflow"],
          "properties": {
            "class": {"enum": ["free_public", "official_free_tier", "unknown"]},
            "denyMeteredOverflow": {"type": "boolean"},
            "notes": {"type": "string"}
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnlyByDefault", "cacheWhereAllowed", "respectRetryAfter", "verifyTermsAtActivation"],
          "properties": {
            "readOnlyByDefault": {"type": "boolean"},
            "cacheWhereAllowed": {"type": "boolean"},
            "respectRetryAfter": {"type": "boolean"},
            "verifyTermsAtActivation": {"type": "boolean"},
            "notes": {"type": "string"}
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "method"],
          "properties": {
            "enabled": {"type": "boolean"},
            "method": {"enum": ["GET", "HEAD", "MANUAL"]},
            "url": {"type": "string", "pattern": "^https://"},
            "expectedStatus": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 100, "maximum": 599}
            },
            "notes": {"type": "string"}
          }
        },
        "productionReady": {"type": "boolean"},
        "reviewNotes": {"type": "string"}
      }
    }
  }
}
